
from graphics import *
import time


def main():
    height = float(input("Enter the initial height in meters: "))

    if height <= 0:
        print("Please enter a positive height.")
        return

    win = GraphWin("Bouncing Ball", 400, 500)
    win.setCoords(0, -height * 0.1, 10, height * 1.1)

    ground = Line(Point(0, 0), Point(10, 0))
    ground.draw(win)

    radius = height * 0.025
    ball = Circle(Point(5, height), radius)
    ball.setFill("red")
    ball.draw(win)

    bounces = 0
    current_height = height

    while True:
        center = ball.getCenter()
        ball.move(0, radius - center.getY())
        time.sleep(0.5)

        bounces += 1
        current_height = current_height * 0.60

        if current_height < 0.001:
            break

        center = ball.getCenter()
        ball.move(0, current_height - center.getY())
        time.sleep(0.5)

    message = Text(
        Point(5, height * 0.5),
        "Total bounces: " + str(bounces)
    )
    message.draw(win)

    win.getMouse()
    win.close()


main()
