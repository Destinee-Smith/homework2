import string

def clean(text):
    return "".join(
        ch for ch in text.upper()
        if ch in string.ascii_uppercase
    )

def column_order(keyword):
    return sorted(
        range(len(keyword)),
        key=lambda i: (keyword[i], i)
    )

def encrypt(message, keyword):
    message = clean(message)
    keyword = clean(keyword)

    if not keyword:
        raise ValueError("Keyword must contain letters.")

    if not message:
        raise ValueError("Message must contain letters.")

    cols = len(keyword)
    rows = math.ceil(len(message) / cols)

    padded = message + "".join(
        random.choices(
            string.ascii_uppercase,
            k=rows * cols - len(message)
        )
    )

    grid = [
        list(padded[r * cols:(r + 1) * cols])
        for r in range(rows)
    ]

    cipher = "".join(
        grid[r][c]
        for c in column_order(keyword)
        for r in range(rows)
    )

    return cipher, grid

def decrypt(cipher, keyword, original_length):
    keyword = clean(keyword)
    cols = len(keyword)

    if not cols or len(cipher) % cols:
        raise ValueError("Invalid keyword or ciphertext length.")

    rows = len(cipher) // cols

    grid = [
        [""] * cols
        for _ in range(rows)
    ]

    pos = 0

    for c in column_order(keyword):
        for r in range(rows):
            grid[r][c] = cipher[pos]
            pos += 1

    return "".join(
        "".join(row) for row in grid
    )[:original_length]

if __name__ == "__main__":
