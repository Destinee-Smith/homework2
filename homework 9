import tkinter as tk
import math

GRAVITY = 0.20
RESTITUTION = 0.60
FLOOR = 420
RADIUS = 15

def main():
    root = tk.Tk()
    root.title("Three Bouncing Balls")

    canvas = tk.Canvas(root, width=600, height=460, bg="white")
    canvas.pack()

    balls = []

    for x, height, color in [
        (120, 300, "red"),
        (300, 230, "blue"),
        (480, 370, "green")
    ]:
        item = canvas.create_oval(
            x - RADIUS,
            FLOOR - height - RADIUS,
            x + RADIUS,
            FLOOR - height + RADIUS,
            fill=color
        )

        balls.append({
            "item": item,
            "height": float(height),
            "velocity": 0.0,
            "bounces": 0
        })

    canvas.create_line(
        0, FLOOR + RADIUS,
        600, FLOOR + RADIUS,
        width=2
    )

    def animate():
        moving = False

        for ball in balls:
            if ball["height"] <= 0 and ball["velocity"] == 0:
                continue

            moving = True

            ball["velocity"] -= GRAVITY
            ball["height"] += ball["velocity"]

            if ball["height"] <= 0:
                ball["height"] = 0
                ball["bounces"] += 1

                ball["velocity"] = (
                    abs(ball["velocity"]) * math.sqrt(RESTITUTION)
                )

                if ball["velocity"] ** 2 / (2 * GRAVITY) < 0.001:
                    ball["velocity"] = 0

            x1, _, x2, _ = canvas.coords(ball["item"])
            y = FLOOR - ball["height"]

            canvas.coords(
                ball["item"],
                x1, y - RADIUS,
                x2, y + RADIUS
            )

        if moving:
            root.after(16, animate)

    animate()
    root.mainloop()

if __name__ == "__main__":
    main()
ALPHABET = "ABCDEFGHIKLMNOPQRSTUVWXYZ"

CHECKERBOARD = tuple(
    tuple(ALPHABET[r * 5:(r + 1) * 5])
    for r in range(5)
)

def locate(letter):
    letter = letter.upper().replace("J", "I")

    for row, letters in enumerate(CHECKERBOARD):
        for col, char in enumerate(letters):
            if char == letter:
                return (row, col)

    raise ValueError("Use letters A-Z only.")

def encrypt(message):
    result = []

    for char in message.upper():
        if char.isalpha():
            row, col = locate(char)

            result.append(
                str(row + 1) + str(col + 1)
            )

    return " ".join(result)

def decrypt(ciphertext):
    digits = "".join(
        ch for ch in ciphertext if ch.isdigit()
    )

    if len(digits) % 2:
        raise ValueError("Ciphertext needs pairs of digits.")

    result = []

    for i in range(0, len(digits), 2):
        position = (
            int(digits[i]) - 1,
            int(digits[i + 1]) - 1
        )

        row, col = position

        if not (0 <= row < 5 and 0 <= col < 5):
            raise ValueError("Coordinates must be 1 through 5.")

        result.append(CHECKERBOARD[row][col])

    return "".join(result)

if __name__ == "__main__":
    message = input("Message to encrypt: ")

    cipher = encrypt(message)

    print("Checkerboard:")

    for row in CHECKERBOARD:
        print(" ".join(row))

    print("Encrypted:", cipher)
    print("Decrypted:", decrypt(cipher))

