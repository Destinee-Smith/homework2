import string

ROWS = 5
COLS = 6

def clean(text):
    return "".join(
        c for c in text.upper()
        if c in string.ascii_uppercase
    )

def spiral_path(rows, cols):
    path = []

    top = 0
    bottom = rows - 1
    left = 0
    right = cols - 1

    while top <= bottom and left <= right:

        for c in range(left, right + 1):
            path.append((top, c))

        top += 1

        for r in range(top, bottom + 1):
            path.append((r, right))

        right -= 1

        if top <= bottom:
            for c in range(right, left - 1, -1):
                path.append((bottom, c))

            bottom -= 1

        if left <= right:
            for r in range(bottom, top - 1, -1):
                path.append((r, left))

            left += 1

    return path

PATH = spiral_path(ROWS, COLS)

def encrypt(message):
    message = clean(message)

    if len(message) > ROWS * COLS:
        raise ValueError("Maximum is 30 letters.")

    padding = "".join(
        random.choices(
            string.ascii_uppercase,
            k=ROWS * COLS - len(message)
        )
    )

    data = message + padding

    grid = [
        list(data[r * COLS:(r + 1) * COLS])
        for r in range(ROWS)
    ]

    cipher = "".join(
        grid[r][c]
        for r, c in PATH
    )

    return cipher, grid

def decrypt(cipher, original_length):

    if len(cipher) != ROWS * COLS:
        raise ValueError("Ciphertext must contain 30 letters.")

    grid = [
        [""] * COLS
        for _ in range(ROWS)
    ]

    for (r, c), char in zip(
        reversed(PATH),
        reversed(cipher)
    ):
        grid[r][c] = char

    return "".join(
        "".join(row) for row in grid
    )[:original_length]

if __name__ == "__main__":
    message = input("Message (up to 30 letters): ")

    cipher, grid = encrypt(message)

    print("Grid:")

    for row in grid:
        print(" ".join(row))

    print("Encrypted:", cipher)

    print(
        "Decrypted:",
        decrypt(cipher, len(clean(message)))
    )

  import random
import string

def clean(text):
    return "".join(
        c for c in text.upper()
        if c in string.ascii_uppercase
    )

def order(keyword):
    return sorted(
        range(len(keyword)),
        key=lambda i: (keyword[i], i)
    )

def make_path(rows, cols):
    return [
        (r, c)
        for r in range(rows)
        for c in (
            range(cols)
            if r % 2 == 0
            else range(cols - 1, -1, -1)
        )
    ]

def encrypt(message, keyword, rows):
    message = clean(message)
    keyword = clean(keyword)

    if not keyword or rows < 1:
        raise ValueError(
            "Provide a keyword and a positive row count."
        )

    cols = len(keyword)
    capacity = rows * cols

    if len(message) > capacity:
        raise ValueError(
            "Message is too long for the selected grid."
        )

    padded = message + "".join(
        random.choices(
            string.ascii_uppercase,
            k=capacity - len(message)
        )
    )

    grid = [
        list(padded[r * cols:(r + 1) * cols])
        for r in range(rows)
    ]

    reordered = [
        [grid[r][c] for c in order(keyword)]
        for r in range(rows)
    ]

    path = make_path(rows, cols)

    cipher = "".join(
        reordered[r][c]
        for r, c in path
    )

    return cipher, len(message), grid

def decrypt(cipher, keyword, rows, original_length):
    keyword = clean(keyword)
    cols = len(keyword)

    if not cols or rows < 1 or len(cipher) != rows * cols:
        raise ValueError(
            "Keyword, grid size or ciphertext is invalid."
        )

    reordered = [
        [""] * cols
        for _ in range(rows)
    ]

    path = make_path(rows, cols)

    for (r, c), char in zip(
        reversed(path),
        reversed(cipher)
    ):
        reordered[r][c] = char

    grid = [
        [""] * cols
        for _ in range(rows)
    ]

    for new_col, old_col in enumerate(order(keyword)):
        for r in range(rows):
            grid[r][old_col] = reordered[r][new_col]

    return "".join(
        "".join(row) for row in grid
    )[:original_length]

if __name__ == "__main__":
    message = input("Message: ")
    keyword = input("Keyword: ")
    rows = int(input("Number of grid rows: "))

    cipher, length, grid = encrypt(
        message, keyword, rows
    )

    print("Original grid:")

    for row in grid:
        print(" ".join(row))

    print("Encrypted:", cipher)

    print(
        "Decrypted:",
        decrypt(cipher, keyword, rows, length)
    )
