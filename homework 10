import string

def frequency_analysis(filename):
    with open(filename, "r", encoding="utf-8") as file:
        text = file.read().upper()

    total_characters = len(text)

    letters = string.ascii_uppercase
    counts = {letter: 0 for letter in letters}

    for char in text:
        if char in counts:
            counts[char] += 1

    if total_characters == 0:
        print("The file is empty.")
        return

    frequencies = [
        counts[letter] / total_characters * 100
        for letter in letters
    ]

    plt.figure(figsize=(12, 6))
    plt.bar(letters, frequencies)

    plt.title("Letter Frequency Analysis")
    plt.xlabel("Letters")
    plt.ylabel("Frequency (%)")

    plt.ylim(0, max(frequencies) * 1.1 if max(frequencies) else 1)
    plt.grid(axis="y", alpha=0.3)

    plt.show()

    print("\nLetter Frequency Report")

    for letter, frequency in zip(letters, frequencies):
        print(f"{letter}: {frequency:.2f}%")


def main():
    filename = input("Enter text filename: ")

    try:
        frequency_analysis(filename)
    except FileNotFoundError:
        print("File not found. Please check the filename.")


if __name__ == "__main__":
    main()

import os
import string
import matplotlib.pyplot as plt

def analyze_python_files(folder):
    letters = string.ascii_uppercase

    counts = {letter: 0 for letter in letters}
    total_characters = 0
    files_processed = 0

    for filename in os.listdir(folder):
        if filename.endswith(".py"):
            filepath = os.path.join(folder, filename)

            if os.path.isfile(filepath):
                with open(
                    filepath,
                    "r",
                    encoding="utf-8",
                    errors="replace"
                ) as file:
                    text = file.read().upper()

                total_characters += len(text)
                files_processed += 1

                for char in text:
                    if char in counts:
                        counts[char] += 1

    if files_processed == 0:
        print("No Python files were found.")
        return

    frequencies = [
        counts[letter] / total_characters * 100
        for letter in letters
    ]

    plt.figure(figsize=(12, 6))
    plt.bar(letters, frequencies)

    plt.title("Python Code Letter Frequency Analysis")
    plt.xlabel("Letters")
    plt.ylabel("Frequency (%)")

    plt.ylim(
        0,
        max(frequencies) * 1.1 if max(frequencies) else 1
    )

    plt.grid(axis="y", alpha=0.3)
    plt.show()

    print("Python files analyzed:", files_processed)
    print("Total characters:", total_characters)

    for letter, frequency in zip(letters, frequencies):
        print(f"{letter}: {frequency:.2f}%")


def main():
    folder = input("Enter folder path: ")

    if os.path.isdir(folder):
        analyze_python_files(folder)
    else:
        print("Invalid folder path.")


if __name__ == "__main__":
    main()

import urllib.request
import string
import matplotlib.pyplot as plt

def download_text(url):
    with urllib.request.urlopen(url, timeout=30) as response:
        data = response.read()

    return data.decode("utf-8", errors="replace")


def frequency_analysis(text):
    letters = string.ascii_uppercase

    counts = {letter: 0 for letter in letters}

    # Count all characters in the lower 256 Unicode values.
    total_characters = 0

    for char in text.upper():
        if ord(char) < 256:
            total_characters += 1

            if char in counts:
                counts[char] += 1

    frequencies = {}

    for letter in letters:
        if total_characters > 0:
            frequencies[letter] = (
                counts[letter] / total_characters * 100
            )
        else:
            frequencies[letter] = 0

    return counts, frequencies


def display_graph(frequencies):
    letters = list(frequencies.keys())
    values = list(frequencies.values())

    plt.figure(figsize=(12, 6))
    plt.bar(letters, values)

    plt.title("Online Text Letter Frequency Analysis")
    plt.xlabel("Letters")
    plt.ylabel("Frequency (%)")

    plt.ylim(
        0,
        max(values) * 1.1 if max(values) else 1
    )

    plt.grid(axis="y", alpha=0.3)
    plt.show()


def save_results(filename, counts, frequencies):
    with open(filename, "w", encoding="utf-8") as file:
        file.write("Letter,Count,Frequency (%)\n")

        for letter in string.ascii_uppercase:
            file.write(
                f"{letter},{counts[letter]},"
                f"{frequencies[letter]:.4f}\n"
            )

    print("Frequency results saved to:", filename)


def main():
    print("Online Letter Frequency Analysis")

    url = input(
        "Enter text URL (press Enter for Shakespeare): "
    )

    if not url:
        url = (
            "https://www.gutenberg.org/"
            "cache/epub/100/pg100.txt"
        )

    filename = input("Enter output CSV filename: ")

    if not filename:
        filename = "frequency_results.csv"

    try:
        print("Downloading text...")
        text = download_text(url)

        counts, frequencies = frequency_analysis(text)

        print("Download completed.")

        display_graph(frequencies)
        save_results(filename, counts, frequencies)

        print("\nLetter Frequency Results:")

        for letter in string.ascii_uppercase:
            print(
                f"{letter}: {counts[letter]} occurrences, "
                f"{frequencies[letter]:.2f}%"
            )

    except Exception as error:
        print("An error occurred:", error)


if __name__ == "__main__":
    main()
