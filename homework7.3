
def main():
    height = float(input("Enter the initial height in meters: "))

    if height <= 0:
        print("Please enter a positive height.")
        return

    bounces = 0

    while True:
        height = height * 0.60
        bounces += 1

        if height < 0.001:
            break

    print("The ball bounced", bounces, "times.")


main()
